{
  "bundle": {
    "resources": ["resources/**/*"],
    "windows": {
      "nsis": {
        "compression": "zlib",
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      }
    }
  }
}
