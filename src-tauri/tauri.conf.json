{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteBi",
  "version": "0.3.0",
  "identifier": "com.notebi.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoteBi",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "本地优先的 AI 多媒体笔记工具",
    "longDescription": "NoteBi 在本地整理视频、音频、图文和文字，生成可编辑的结构化笔记。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {}
  }
}
